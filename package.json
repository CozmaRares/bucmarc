{
    "name": "bucmarc",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write .",
        "dev": "bun --hot src/index.ts",
        "start": "bun dist/index.js",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "lint": "eslint .",
        "check:types": "bun node_modules/@typescript/native/bin/tsc --noEmit",
        "check:unused": "SKIP_ENV_VALIDATION=true knip",
        "check:cycles": "bun run --bun dependency-cruiser src --config .dependency-cruiser.cjs --output-type err --no-progress",
        "check": "bun run --parallel check:types check:unused check:cycles lint",
        "build": "bun build src/index.ts --outdir=dist --target=bun"
    },
    "devDependencies": {
        "@libsql/client": "0.18.0",
        "@types/bun": "1.3.14",
        "@types/node": "26.1.0",
        "@typescript-eslint/parser": "8.67.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "dependency-cruiser": "18.4.0",
        "drizzle-kit": "0.31.10",
        "eslint": "10.8.1",
        "husky": "9.1.7",
        "knip": "6.24.0",
        "prettier": "3.8.3",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@clerk/hono": "0.1.33",
        "@hono/zod-validator": "0.8.0",
        "@t3-oss/env-core": "0.13.11",
        "chalk": "5.6.2",
        "drizzle-orm": "0.45.2",
        "hono": "4.12.23",
        "neverthrow": "8.2.0",
        "zod": "4.4.3"
    }
}
